// `[no_undeclared_includes]` is required for C++ interop (`-cxx-interoperability-mode`):
// without it, building this pure-C libc module in C++ mode lets an internal
// `#include <inttypes.h>` resolve to libc++'s `std_inttypes_h` wrapper module (libc++
// is searched ahead of the C library and cannot be reordered), which transitively
// re-requires this module — a cyclic module dependency. The attribute restricts this
// module's build to its own declared headers, so the include resolves to its own C
// `inttypes.h` and the cycle is broken. Clang builtin (`_Builtin_*`) modules such as
// `<stddef.h>` remain available regardless, so this does not sever the C builtins.
module SwiftEmscriptenLibc [system] [no_undeclared_includes] {
  header "stdc-predef.h"
  header "features.h"

  // C standard library
  header "ctype.h"
  header "errno.h"
  header "fenv.h"
  header "inttypes.h"
  header "locale.h"
  header "math.h"
  header "stdio.h"
  header "stdlib.h"
  header "string.h"
  header "time.h"

  // POSIX
  header "arpa/inet.h"
  header "cpio.h"
  header "dirent.h"
  header "fcntl.h"
  header "fmtmsg.h"
  header "fnmatch.h"
  header "ftw.h"
  header "glob.h"
  header "iconv.h"
  header "ifaddrs.h"
  header "langinfo.h"
  header "libgen.h"
  header "monetary.h"
  header "netinet/in.h"
  header "netinet/tcp.h"
  header "nl_types.h"
  header "poll.h"
  header "regex.h"
  header "sched.h"
  header "search.h"
  header "semaphore.h"
  header "signal.h"
  header "strings.h"
  header "sys/file.h"
  header "sys/ioctl.h"
  header "sys/mman.h"
  header "sys/resource.h"
  header "sys/select.h"
  header "sys/socket.h"
  header "sys/stat.h"
  header "sys/time.h"
  header "sys/times.h"
  header "sys/types.h"
  header "sys/uio.h"
  header "sys/un.h"
  header "sys/utsname.h"
  header "sysexits.h"
  header "pthread.h"
  header "tar.h"
  header "unistd.h"
  header "utime.h"

  // Emscripten's musl-based libc uses WASI's errno ABI: <bits/errno.h>
  // includes this header and maps POSIX errno names to __WASI_ERRNO_* values.
  header "wasi/api.h"
  export *

  // complex.h defines `#define complex _Complex` (musl, never #undef'd). Under C++
  // interop this macro leaks through the parent's `export *` into libc++'s `std` Clang
  // module and breaks its `template class complex` (<complex>:287 "declaration of
  // anonymous class must be a definition"). Isolating complex.h into an `explicit`
  // submodule keeps it out of the parent's `export *` (explicit submodules are not
  // auto-imported), so the macro no longer leaks. complex.h's C functions take
  // `_Complex` parameters and were never importable into Swift, so no Swift-visible
  // API is lost; keeping the header in its own submodule (rather than dropping it)
  // preserves a clean module owner for `#include <complex.h>` under the parent's
  // `[no_undeclared_includes]`.
  explicit module Complex {
    header "complex.h"
    export *
  }
}
